{
  "name": "acoustic-modem",
  "version": "0.0.0",
  "private": true,
  "description": "Browser-based acoustic modem: send data between two devices using only a speaker and a microphone.",
  "license": "MIT",
  "author": "Daniel Peña (https://github.com/danipe07)",
  "homepage": "https://danipe07.github.io/acoustic-modem/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danipe07/acoustic-modem.git"
  },
  "bugs": {
    "url": "https://github.com/danipe07/acoustic-modem/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.json && tsc -p tsconfig.scripts.json",
    "bench": "node scripts/ber-bench.ts docs/results/phase1-ber.md",
    "replay": "node scripts/replay.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
